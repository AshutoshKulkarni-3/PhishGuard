# ─── Virtual Environments ────────────────────────────────────────────────────
venv/
.venv/
env/
.env/
ENV/

# ─── Python Cache & Build Artefacts ──────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.egg
*.egg-info/
dist/
build/
.eggs/

# ─── Generated / Trained Model Files ─────────────────────────────────────────
model/*.pkl
model/*.joblib
model/*.h5
model/*.pt
model/*.onnx

# ─── Dataset Files (can be large) ────────────────────────────────────────────
dataset/*.csv
dataset/*.json
dataset/*.parquet
dataset/*.joblib
dataset/*.zip

# ─── Secrets & Environment Config ────────────────────────────────────────────
.env
.env.*
secrets.json
config/local_*.py

# ─── IDE / Editor ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ─── Jupyter Notebooks (optional artefacts) ──────────────────────────────────
.ipynb_checkpoints/

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Coverage / Testing ──────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
